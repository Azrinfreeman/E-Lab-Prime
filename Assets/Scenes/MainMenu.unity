  m_Script: {fileID: 11500000, guid: 9ab3d487a5770ee4c95df086d63f1ddb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MainMenuProfessorGuide
  rootGroup: {fileID: 1340978556}
  professorImage: {fileID: 728132690}
  nameText: {fileID: 1539032824}
  malayText: {fileID: 1680870393}
  englishSubtitleText: {fileID: 383027925}
  continueButton: {fileID: 1459795369}
  skipButton: {fileID: 419257725}
  audioSource: {fileID: 1340978554}
  appearSfx: {fileID: 8300000, guid: 2fb9d97377487184eb53911c70d08249, type: 3}
  textBlipSfx: {fileID: 8300000, guid: 274dd050e5c5c3846a06700e7ba85308, type: 3}
  highlightSfx: {fileID: 8300000, guid: 9256131d64afcee4ba50ea618197565f, type: 3}
  professorName: PROF. HAKIM
  typewriterCharactersPerSecond: 36
  introFadeSeconds: 0.35
  hoverPromptCooldown: 1.2
  startupDelaySeconds: 0.35
  avatarBreathScale: 0.018
  dialogueLines:
  - context: 0
    avatarPose: 3
    malayText: Selamat datang ke Makmal Sains Digital.
    englishSubtitle: '[Welcome to the Digital Science Lab.]'
    targetKey: 
    voiceClip: {fileID: 8300000, guid: 29ea570f93d5f074b94ad60ee0ccbac0, type: 3}
    skippable: 1
  - context: 1
    avatarPose: 2
    malayText: Log masuk dahulu supaya kemajuan eksperimen anda dapat disimpan.
    englishSubtitle: '[Sign in first so your experiment progress can be saved.]'
    targetKey: SignIn
    voiceClip: {fileID: 8300000, guid: da1563e69a88fd3489e9833b3914c360, type: 3}
    skippable: 1
  - context: 2
    avatarPose: 3
    malayText: Selamat kembali. Mari sambung penerokaan sains anda.
    englishSubtitle: '[Welcome back. Let us continue your science exploration.]'
    targetKey: 
    voiceClip: {fileID: 8300000, guid: 02eca90fcb6a3d344b8c2432cc09c556, type: 3}
    skippable: 1
  - context: 3
    avatarPose: 2
    malayText: Tekan Mulakan Amali untuk memilih eksperimen sains anda.
    englishSubtitle: '[Press Start Experiments to choose your science activity.]'
    targetKey: StartExperiments
    voiceClip: {fileID: 8300000, guid: 253a0dfc15c3cf34793a132c1ee54a69, type: 3}
    skippable: 1
  - context: 4
    avatarPose: 1
    malayText: Laraskan bunyi, paparan, dan pengalaman pembelajaran di sini.
    englishSubtitle: '[Adjust sound, display, and learning experience here.]'
    targetKey: Settings
    voiceClip: {fileID: 8300000, guid: f11e425a04d9eac4baa7e4dd1b94e37c, type: 3}
    skippable: 1
  - context: 5
    avatarPose: 3
    malayText: Di sini anda boleh melihat pencapaian dan kemajuan setiap amali.
    englishSubtitle: '[Here you can view achievements and progress for each experiment.]'
    targetKey: Achievements
    voiceClip: {fileID: 8300000, guid: f056ca407096fb94c9df11478a54f7b8, type: 3}
    skippable: 1
  targets:
  - key: StartExperiments
    button: {fileID: 882830787}
    highlight: {fileID: 1993670064}
  - key: Settings
    button: {fileID: 134358730}
    highlight: {fileID: 1377815555}
  - key: Achievements
    button: {fileID: 1827225268}
    highlight: {fileID: 939230951}
  - key: SignIn
